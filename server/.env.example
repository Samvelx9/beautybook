PORT=4000

# Postgres. Locally e.g. postgres://user:pass@localhost:5432/beautybook
DATABASE_URL=

# Long random string; signs admin sessions. `openssl rand -hex 32`
JWT_SECRET=

# The domain masters' pages live under: <slug>.<PLATFORM_DOMAIN>.
# "localhost" in development (pages at http://<slug>.localhost:5173).
PLATFORM_DOMAIN=localhost
PRODUCT_NAME=BeautyBook

# The platform's public https origin, e.g. https://app.example.com. Set only on
# the deployed server: it turns on the Telegram webhook, reminders and the
# "did the visit happen?" questions, and is where checkout returns to.
PUBLIC_URL=

# The platform's one Telegram bot (from @BotFather). Masters connect to it from
# Settings; no per-master setup.
TELEGRAM_BOT_TOKEN=

# Lemon Squeezy subscriptions. Webhook URL: <PUBLIC_URL>/api/billing/webhook,
# events: all subscription_* ones.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
